{
  "name": "adanma-frontend",
  "version": "1.0.0",
  "description": "Adanma - African E-commerce Platform Frontend",
  "private": true,

  "scripts": {
    "dev": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "lint": "cd frontend && npm run lint",
    "format": "prettier --write \"frontend/**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"frontend/**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.7.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {}
}
