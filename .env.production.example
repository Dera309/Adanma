
# ============================================
# EMAIL SERVICE (SendGrid)
# ============================================
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@your-domain.com
SENDGRID_FROM_NAME=Adanma

# ============================================
# SMS SERVICE (Twilio)
# ============================================
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================
# OAUTH PROVIDERS
# ============================================
# Facebook OAuth
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_CALLBACK_URL=https://adanma.com/api/auth/facebook/callback

# WhatsApp OAuth (if applicable)
WHATSAPP_APP_ID=your-whatsapp-app-id
WHATSAPP_APP_SECRET=your-whatsapp-app-secret
WHATSAPP_CALLBACK_URL=https://adanma.com/api/auth/whatsapp/callback

# ============================================
# FILE STORAGE (AWS S3 or similar)
# ============================================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# ============================================
# REDIS (for caching and sessions)
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your-redis-password

# ============================================
# SECURITY
# ============================================
# Comma-separated list of allowed origins
ALLOWED_ORIGIN_1=https://your-domain.com
ALLOWED_ORIGIN_2=https://www.your-domain.com

# Comma-separated list of blacklisted IPs
BLACKLISTED_IPS=

# Comma-separated list of whitelisted IPs (optional)
WHITELISTED_IPS=

# ============================================
# MONITORING & LOGGING
# ============================================
# Sentry for error tracking
SENTRY_DSN=your-sentry-dsn

# Log level (error, warn, info, debug)
LOG_LEVEL=info

# Enable debug mode
DEBUG=false

# Metrics collection
METRICS_ENABLED=true
METRICS_INTERVAL=300000

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# FRONTEND BUILD
# ============================================
VITE_API_URL=https://api.your-domain.com

# ============================================
# SSL/TLS
# ============================================
SSL_CERT_PATH=/path/to/cert.pem
SSL_KEY_PATH=/path/to/key.pem

# ============================================
# BACKUP
# ============================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
