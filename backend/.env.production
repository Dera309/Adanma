# Production Environment Configuration
# CRITICAL: Replace all placeholder values with real production values

# Server Configuration
NODE_ENV=production
PORT=5000
API_BASE_URL=https://api.your-domain.com

# Production Mode Settings (NEVER enable mock data in production)
SKIP_DB_CHECKS=false
USE_MOCK_DATA=false

# Database Configuration (Replace with your production MongoDB Atlas URL)
DATABASE_URL="mongodb+srv://username:SECURE_PASSWORD@cluster.mongodb.net/adanma_production?retryWrites=true&w=majority"

# JWT Configuration (CRITICAL: Generate new secure secrets)
JWT_ACCESS_SECRET=REPLACE_WITH_SECURE_64_CHAR_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_SECURE_64_CHAR_SECRET
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d

# Session Configuration
SESSION_SECRET=REPLACE_WITH_SECURE_32_CHAR_SECRET

# OAuth Configuration (Replace with your production app credentials)
FACEBOOK_APP_ID=your-production-facebook-app-id
FACEBOOK_APP_SECRET=your-production-facebook-app-secret
FACEBOOK_CALLBACK_URL=https://api.your-domain.com/api/auth/facebook/callback

WHATSAPP_CLIENT_ID=your-production-whatsapp-client-id
WHATSAPP_CLIENT_SECRET=your-production-whatsapp-client-secret
WHATSAPP_CALLBACK_URL=https://api.your-domain.com/api/auth/whatsapp/callback

# SMS Service Configuration (Replace with your production credentials)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-production-twilio-account-sid
TWILIO_AUTH_TOKEN=your-production-twilio-auth-token
TWILIO_PHONE_NUMBER=your-production-twilio-phone-number

# Email Service Configuration (Replace with your production credentials)
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=your-production-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@your-domain.com

# Frontend URL
FRONTEND_URL=https://your-domain.com

# Payment Configuration (Replace with your production Stripe keys)
STRIPE_SECRET_KEY=sk_live_REPLACE_WITH_REAL_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_WITH_REAL_STRIPE_PUBLISHABLE_KEY

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security Configuration
BLACKLISTED_IPS=
ALLOWED_ORIGIN_1=https://your-domain.com
ALLOWED_ORIGIN_2=https://www.your-domain.com